# Lumogis — settings for an install from published images (LUM-980).
#
# Save this file as .env next to docker-compose.yml, then run:
#   docker compose up -d
# Update later with:
#   docker compose pull && docker compose up -d
#
# Every setting below works as it is for a first try. The full list of settings,
# with explanations, is .env.example in the Lumogis repository on GitHub.

# --- Version -----------------------------------------------------------------
# `release` follows the latest Lumogis release. To stay on one version, set it,
# e.g. LUMOGIS_VERSION=0.13.0 (no leading v).
LUMOGIS_VERSION=release

# Keeps the containers and data volumes named lumogis-*; keep it when you move
# or update the install.
COMPOSE_PROJECT_NAME=lumogis

# --- Sign-in -----------------------------------------------------------------
# Sign-in is on. The first person to open Lumogis creates the admin account, so
# open it straight after `docker compose up -d` (http://localhost on this
# computer): until you do, anyone who can reach this computer can create it. If
# someone else did, remove the install and start again; see
# docs/deployment/quickstart.md#sign-in on GitHub.
# On first start Lumogis writes AUTH_SECRET, the refresh secret and
# LUMOGIS_CREDENTIAL_KEY into this file. Keep a copy of it: the credential key
# decrypts the passwords you save in Lumogis.
AUTH_ENABLED=true

# --- Where your files live (folders next to this file by default) -------------
# Documents Lumogis reads (mounted read-only).
FILESYSTEM_ROOT=./lumogis-data
# Uploads, the inbox, captures and the knowledge graph's settings.
WORKSPACE_HOST_DIR=./ai-workspace
# Daily backups, kept for a week.
BACKUP_HOST_DIR=./ai-workspace/backups

# Time zone for scheduled jobs such as the 03:00 backup.
TZ=UTC

# --- Database ----------------------------------------------------------------
# The database is reachable only by the Lumogis containers, never from outside.
# To use your own password, change it before the first start (letters and digits
# only); after that it is stored in the database volume.
POSTGRES_USER=lumogis
POSTGRES_PASSWORD=lumogis-dev
POSTGRES_DB=lumogis
POSTGRES_HOST=postgres

# --- Services (leave as they are) ---------------------------------------------
QDRANT_URL=http://qdrant:6333
OLLAMA_URL=http://ollama:11434
VECTOR_STORE_BACKEND=qdrant
METADATA_STORE_BACKEND=postgres
EMBEDDER_BACKEND=ollama
EMBEDDING_MODEL=nomic-embed-text

# --- Secrets -----------------------------------------------------------------
# These placeholders are replaced with random values on the first start, and
# this file is updated with them. Do not share this file.
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
RESTART_SECRET=change-me-to-a-random-secret

# --- Web address -------------------------------------------------------------
# :80 serves Lumogis on this computer's address over plain HTTP, for your home
# network. For a real domain with HTTPS, set e.g. CADDY_DOMAIN=lumogis.example.com
CADDY_DOMAIN=:80

# --- Speech-to-text (on) -------------------------------------------------------
# The microphone button turns speech into text on this computer; audio never
# leaves it. The only things the speech engine fetches are the speech model
# (about 280 MB, once) and update checks for it, both from huggingface.co.
# It costs about 3.3 GB of disk (a download of about 1.1 GB with the first
# `docker compose up -d`) and about 0.6 GB of memory while it transcribes
# (docs/deployment/quickstart.md#speech-to-text).
# The microphone works on this computer at http://localhost. Phones and other
# computers need Admin -> Secure address first: browsers only give a page the
# microphone over HTTPS.
# To turn it off: remove stt from COMPOSE_PROFILES, set STT_BACKEND=none, then run
#   docker compose stop lumogis-stt && docker compose rm -f lumogis-stt
#   docker compose up -d
# For languages other than English use STT_MODEL=Systran/faster-whisper-base
COMPOSE_PROFILES=stt
STT_BACKEND=whisper_sidecar
STT_SIDECAR_URL=http://lumogis-stt:8000
STT_MODEL=Systran/faster-whisper-base.en

# --- Knowledge graph (optional, off by default) --------------------------------
# The easy way: Admin -> Knowledge graph -> Turn on. Lumogis writes these lines
# for you. By hand instead: add graph to the COMPOSE_PROFILES line above (for
# example COMPOSE_PROFILES=stt,graph), remove the # from each line below, replace
# the secret with a long random value, then run: docker compose up -d
# It needs a computer with plenty of memory (the quickstart says how much) and
# downloads about 1 GB the first time.
# GRAPH_MODE=service
# KG_SERVICE_URL=http://lumogis-graph:8001
# CAPABILITY_SERVICE_URLS=http://lumogis-graph:8001
# FALKORDB_URL=redis://falkordb:6379
# GRAPH_WEBHOOK_SECRET=<a long random value>
