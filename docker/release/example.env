# Lumogis — settings for an install from published images (LUM-980).
#
# Save this file as .env next to docker-compose.yml, then run:
#   docker compose up -d
# Update later with:
#   docker compose pull && docker compose up -d
#
# Every setting below works as it is for a first try. The full list of settings,
# with explanations, is .env.example in the Lumogis repository on GitHub.

# --- Version -----------------------------------------------------------------
# `release` follows the latest Lumogis release. To stay on one version, set it,
# e.g. LUMOGIS_VERSION=0.13.0 (no leading v).
LUMOGIS_VERSION=release

# Keeps the containers and data volumes named lumogis-*; keep it when you move
# or update the install.
COMPOSE_PROJECT_NAME=lumogis

# --- Sign-in -----------------------------------------------------------------
# Sign-in is off: Lumogis opens straight in, with you as the only user and
# admin — and so would anyone else who can reach this computer's address.
# Turn sign-in on before other people share your network:
# docs/deployment/quickstart.md#turn-on-sign-in on GitHub.
AUTH_ENABLED=false

# --- Where your files live (folders next to this file by default) -------------
# Documents Lumogis reads (mounted read-only).
FILESYSTEM_ROOT=./lumogis-data
# Uploads, the inbox, captures and the knowledge graph's settings.
WORKSPACE_HOST_DIR=./ai-workspace
# Daily backups, kept for a week.
BACKUP_HOST_DIR=./ai-workspace/backups

# Time zone for scheduled jobs such as the 03:00 backup.
TZ=UTC

# --- Database ----------------------------------------------------------------
# The database is reachable only by the Lumogis containers, never from outside.
# To use your own password, change it before the first start (letters and digits
# only); after that it is stored in the database volume.
POSTGRES_USER=lumogis
POSTGRES_PASSWORD=lumogis-dev
POSTGRES_DB=lumogis
POSTGRES_HOST=postgres

# --- Services (leave as they are) ---------------------------------------------
QDRANT_URL=http://qdrant:6333
OLLAMA_URL=http://ollama:11434
VECTOR_STORE_BACKEND=qdrant
METADATA_STORE_BACKEND=postgres
EMBEDDER_BACKEND=ollama
EMBEDDING_MODEL=nomic-embed-text

# --- Secrets -----------------------------------------------------------------
# These placeholders are replaced with random values on the first start, and
# this file is updated with them. Do not share this file.
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
RESTART_SECRET=change-me-to-a-random-secret

# --- Web address -------------------------------------------------------------
# :80 serves Lumogis on this computer's address over plain HTTP, for your home
# network. For a real domain with HTTPS, set e.g. CADDY_DOMAIN=lumogis.example.com
CADDY_DOMAIN=:80
