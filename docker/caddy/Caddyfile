#
# Lumogis Caddy front door.
#
# Single-origin reverse proxy: the SPA (lumogis-web) and the orchestrator
# share one hostname so refresh cookies can be SameSite=Strict and the
# orchestrator's `Origin` check (csrf.require_same_origin) sees the SPA's
# own origin. Path table:
#
#   /api/*    -> orchestrator:8000  (REST API + auth)
#   /events   -> orchestrator:8000  (Server-Sent Events)
#   /v1/*     -> orchestrator:8000  (legacy chat compatibility)
#   /mcp/*    -> orchestrator:8000  (MCP-over-HTTP)
#   /health, legacy admin HTML, etc. -> orchestrator:8000  (see handle blocks)
#   /         -> lumogis-web:80     (SPA static bundle, with SPA fallback)
#
# CADDY_DOMAIN: production hostname (e.g. lumogis.example.com). Caddy will
# auto-provision an ACME cert for it. For LAN-only family deployments you
# can use a `.local` mDNS name with `tls internal` instead — see the
# commented block at the bottom.
{
	servers {
		# Caddy trusts no upstream by default, so {client_ip} is the TCP peer
		# and a client-sent X-Forwarded-For is never believed. Behind Tailscale
		# Serve, Cloudflare Tunnel or a host proxy, set
		# LUMOGIS_CADDY_TRUSTED_PROXIES to the compose gateway /32 (space-
		# separated CIDRs); see docs/deployment/remote-access.md (LUM-887).
		trusted_proxies static {$LUMOGIS_CADDY_TRUSTED_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
	}
}

# Every route to Core goes through this snippet. A new route to the
# orchestrator must `import to_orchestrator`.
#
# Client IP (LUM-887): Caddy hands Core exactly one X-Forwarded-For value (the
# resolved client IP) and drops any client-supplied X-Real-IP.
#
# Upstream keep-alive (LUM-875): Caddy pools upstream connections and, by
# default, keeps an idle one for 2 minutes. The orchestrator's uvicorn closes an
# idle connection after its --timeout-keep-alive (75 s, orchestrator/Dockerfile).
# If uvicorn closes first, Caddy can reuse a connection that is already closing:
# the request gets EOF or connection reset, and because Caddy does not retry a
# POST, the client gets 502. Keeping Caddy's idle timeout below uvicorn's makes
# Caddy the side that closes idle connections, so that race cannot happen.
# orchestrator/tests/test_uvicorn_keepalive_vs_caddy.py fails on any
# `reverse_proxy orchestrator:8000` without a keepalive below uvicorn's.
(to_orchestrator) {
	reverse_proxy orchestrator:8000 {
		header_up X-Forwarded-For {client_ip}
		header_up -X-Real-IP
		transport http {
			keepalive 60s
		}
	}
}

{$CADDY_DOMAIN} {
	encode zstd gzip

	# Common security headers (all responses, HTTP or HTTPS). HSTS is added
	# only for TLS requests — see the @https matcher at the end of the block.
	# Do not set HSTS for plain-HTTP CADDY_DOMAIN=:80; the @https matcher
	# prevents emitting it for cleartext responses.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Tighten over time: connect-src is widened for same-origin + SSE/WebSocket
		Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws: wss:; form-action 'self'"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()"
		# Caddy sets Server by default; reduce fingerprinting slightly.
		-Server
	}

	# Core trusts only this container (LUMOGIS_TRUSTED_PROXIES=caddy) and reads
	# the single X-Forwarded-For value set by `header_up` in to_orchestrator.

	# HSTS: only for HTTPS. With CADDY_DOMAIN=:80 this matcher never matches.
	@https {
		protocol https
	}
	header @https {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}

	# Orchestrator root health (not served by the SPA).
	handle /health {
		import to_orchestrator
	}

	# Server-Sent Events: long-lived, no buffering.
	handle /events* {
		reverse_proxy orchestrator:8000 {
			header_up X-Forwarded-For {client_ip}
			header_up -X-Real-IP
			flush_interval -1
			transport http {
				read_buffer 4KB
				write_buffer 4KB
				response_header_timeout 0s
				# Same idle cap as (to_orchestrator), LUM-875.
				keepalive 60s
			}
		}
	}

	handle /api/* {
		import to_orchestrator
	}

	handle /v1/* {
		import to_orchestrator
	}

	handle /mcp/* {
		import to_orchestrator
	}

	# Legacy root JSON routes still served by the orchestrator. Keep these
	# before the SPA catch-all. Browser navigations to `/search` and `/audit`
	# remain with Lumogis Web; API-style calls are forwarded.
	@legacy_search_api {
		path /search
		not header Accept *text/html*
	}
	handle @legacy_search_api {
		import to_orchestrator
	}
	@legacy_audit_api {
		path /audit*
		not header Accept *text/html*
	}
	handle @legacy_audit_api {
		import to_orchestrator
	}
	handle /ingest {
		import to_orchestrator
	}
	handle /session* {
		import to_orchestrator
	}
	handle /actions* {
		import to_orchestrator
	}
	handle /routines* {
		import to_orchestrator
	}
	handle /signals* {
		import to_orchestrator
	}
	handle /sources* {
		import to_orchestrator
	}
	handle /me/email-sources {
		import to_orchestrator
	}
	handle /feedback {
		import to_orchestrator
	}
	handle /capabilities {
		import to_orchestrator
	}

	# Root-mounted FastAPI admin routes (orchestrator/routes/admin.py) must reach
	# the orchestrator before the SPA’s nginx try_files (which would return
	# index.html and mask legacy dashboard/settings/KG pages).
	handle /dashboard* {
		import to_orchestrator
	}
	handle /settings* {
		import to_orchestrator
	}
	handle /graph* {
		import to_orchestrator
	}
	handle /kg* {
		import to_orchestrator
	}
	handle /review-queue* {
		import to_orchestrator
	}
	handle /backup* {
		import to_orchestrator
	}
	handle /restore* {
		import to_orchestrator
	}
	handle /permissions* {
		import to_orchestrator
	}
	handle /browse* {
		import to_orchestrator
	}
	handle /export {
		import to_orchestrator
	}
	handle /entities* {
		import to_orchestrator
	}

	# The SPA upstream keeps Caddy's default idle timeout (2 min) against
	# nginx's keepalive_timeout (75 s). The LUM-875 race can happen here too,
	# but this upstream only serves static GETs, and Caddy's transport retries
	# an idempotent request that fails on a reused connection. Cap it as well
	# if lumogis-web ever serves non-idempotent routes.
	handle {
		reverse_proxy lumogis-web:80
	}

	log {
		output stdout
		format console
	}
}

# ------------------------------------------------------------------------
# LAN-only example (uncomment + comment the block above).
#
# lumogis.local {
# 	tls internal
# 	# ... same handle blocks as above ...
# }
