.env
.env.local
.env.*.local
.git/
.cursor/
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Large / irrelevant directories excluded from the orchestrator build context
# (build context is repo root so config/ can be COPY'd into the image).
# Runtime-generated LibreChat config — use librechat.coldstart.yaml in the image only.
config/librechat.yaml
lumogis-data/
ai-workspace/inbox/*
ai-workspace/outbox/*
ai-workspace/backups/
branding/
docs/
docker/
!docker/backup/
!docker/backup/**
mcp-servers/
postgres/
# LUM-980: the orchestrator image carries the schema (init.sql + migrations),
# so an install from the two release files needs no checkout.
!postgres/init.sql
!postgres/migrations/
!postgres/migrations/**
scripts/
!scripts/backup/
!scripts/backup/**
stack-control/
tests/
