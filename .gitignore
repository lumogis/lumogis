.env
.env.local
.env.*.local
!.env.example
.env.bak-*
.env.doctor-tmp-*
.env.lum400-restart-e2e.bak
.compose-root
__pycache__/
*.pyc
.pytest_cache/
venv/
.venv/
.venv-hub-build/
.venv-audit/
.venv-bandit-check/

# LUM-320 — doctor --fix audit NDJSON (operator host; may contain paths)
scripts/doctor/.audit/

# Cursor IDE — local workspace (plans, skills, rules); not part of public
# release trees. See docs/release/public-agpl-release-workflow.md.
.cursor/

# Claude Code — local workspace (slash commands); corpus lives in
# lumogis-devtools/claude/ (symlink). Same split as .cursor.
.claude
.claude/

# Plugin packages mounted at deploy time — not tracked in core.
# Any directory under orchestrator/plugins/ that is not part of core
# should be added here or kept outside this repository entirely.
orchestrator/plugins/*/
# Core-owned KG compatibility shims (see orchestrator/plugins/graph/).
!orchestrator/plugins/graph/
!orchestrator/plugins/graph/**
# Negation above would track __pycache__; keep bytecode out of status.
orchestrator/plugins/graph/**/__pycache__/
!orchestrator/plugins/__init__.py

# ai-workspace runtime content — keep directory structure, not runtime data
ai-workspace/inbox/*
!ai-workspace/inbox/.gitkeep
ai-workspace/outbox/*
!ai-workspace/outbox/.gitkeep
ai-workspace/approved/*
!ai-workspace/approved/.gitkeep
ai-workspace/review/*
!ai-workspace/review/.gitkeep
ai-workspace/backups/*.zip
ai-workspace/backups-test/
ai-workspace/mcp/*.env

# LibreChat — regenerated at runtime from models.yaml + Ollama; do not commit.
# Tracked template: config/librechat.coldstart.yaml
config/librechat.yaml

# Internal maintainer-only notes — not part of the distributed source tree
AUDIT-REPORT.md
REMEDIATION-PLAN.md
# docs/private/ — tracked on private main/dev; stripped from the public AGPL tree by
# scripts/check-public-export.sh (do not gitignore — ignored paths cannot be added reliably).
#
# Operator runbooks (`docs/dev-cheatsheet.md`, `docs/connect-and-verify.md`): committed on
# branch `dev` only. Branch `main` keeps both paths in .gitignore and does not track them.
# Merges from `main` into `dev` may re-add those ignore lines — remove them on `dev` so the
# runbooks stay tracked.
# IDE / OS
.idea/
*.swp
.DS_Store
docker-compose.override.yml

# Compose policy test artefacts (local dev only)
docker-compose.test-policy-adversarial-local*.yml  # LUM-268 — convention; see .cursor/adrs/LUM-268-compose-policy-adversarial-fixture.md
docker-compose.test-policy-adversarial*.local.yml
docker-compose.test-policy-*-local*.yml
docker-compose.test-policy-*.local.yml

lumogis-data/
.qdrant-initialized
.venv-pytest-run/
.verify-venv/
.merge-venv/

# LUM-377 — debug runner tee logs (local only)
target/debug-logs/

# LUM-187 — `make update` rollback state (records previous image refs; local only)
.lumogis-state/

# LUM-618 — Squid SslBump cert is generated per-deploy, never committed.
docker/egress-proxy/bump.pem
