# Lumogis — deterministic defaults for public RC / CI integration tests.
#
# Usage:
#   COMPOSE_PROFILES= COMPOSE_FILE=docker-compose.yml:docker-compose.test.yml:docker-compose.public-rc-stack.yml \
#     docker compose --env-file config/test.env.example up -d
#
# Playwright (make test-ui / verify-public-rc):
#   export PLAYWRIGHT_BASE_URL=http://127.0.0.1
#   # Stack must serve Lumogis Web via Caddy on that origin (port 80 → http://127.0.0.1).
#
# Integration pytest started inside the orchestrator container (make test-integration)
# uses LUMOGIS_WEB_BASE_URL=http://caddy automatically; on the host, defaults below apply.

# --- Compose / profiles ---
COMPOSE_PROJECT_NAME=lumogis-test
COMPOSE_FILE=docker-compose.yml:docker-compose.test.yml:docker-compose.public-rc-stack.yml
# Playwright onboarding helpers (e2e-postgres.ts docker compose exec).
LUMOGIS_E2E_COMPOSE_FILES=docker-compose.yml:docker-compose.test.yml:docker-compose.public-rc-stack.yml
LUMOGIS_E2E_ENV_FILE=config/test.env.example
# RC stack enables llama only — use for LUM-503 integration + document-chat live prove.
LUMOGIS_E2E_CHAT_MODEL=llama
# Host publish for Qdrant (${...}:6333). Default dev stack uses 6334; use 6335 here so
# verify-public-rc can run beside an active `lumogis` compose project without bind clashes.
QDRANT_HOST_PORT=6335
# Host publish for Postgres (docker-compose.test.yml). Default dev uses 5432; 5433 avoids
# clashing with a local Postgres while host pytest probes memory counts (LUM-540).
POSTGRES_HOST_PORT=5433
# Host-side probes only (pytest on the developer machine, scripts hitting 127.0.0.1:5433).
# docker-compose.test.yml overrides POSTGRES_HOST/PORT to postgres:5432 for in-container
# services (orchestrator, lumogis-graph) — do not point containers at 127.0.0.1:5433.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
# Faster smoke stack: skip LibreChat + Mongo unless you opt back in.
COMPOSE_PROFILES=

# --- Web smoke ---
PLAYWRIGHT_BASE_URL=http://127.0.0.1
LUMOGIS_WEB_BASE_URL=http://127.0.0.1
LUMOGIS_API_URL=http://127.0.0.1:8000

# Same-origin cookie CSRF for Playwright + host pytest hitting http://127.0.0.1 through Caddy.
LUMOGIS_PUBLIC_ORIGIN=http://127.0.0.1

# --- Orchestrator (lumogis-test stack — AUTH_ENABLED=true for login + integration Bearer) ---
AUTH_ENABLED=true
# Deterministic non-production secrets for the disposable compose stack only.
AUTH_SECRET=aabbccddeeff0011223344556677889900aabbccddeeff00112233445566778899
LUMOGIS_CREDENTIAL_KEY=dGwtx7svqjT1EJJNtroYkmO3wICl7ekInYOBlHNLBVA=
GRAPH_MODE=inprocess
# LUM-210 CONTEXT_BUILDING entity budget / hybrid (optional overrides):
# LUMOGIS_CONTEXT_ENTITY_BUDGET=5
# LUMOGIS_CONTEXT_BUILDER_SEMANTIC=false
# LUMOGIS_CONTEXT_BUILDER_SEMANTIC_TOPK=5
# LUMOGIS_CONTEXT_BUILDER_SEMANTIC_THRESHOLD=0.75
# LUMOGIS_CONTEXT_ENTITY_RANK_ALPHA=1.0
# LUMOGIS_CONTEXT_ENTITY_RANK_BETA=0.5
# LUMOGIS_CONTEXT_ENTITY_RANK_GAMMA=0.0
# LUMOGIS_CONTEXT_ENTITY_RANK_DELTA=0.0
# LUMOGIS_CONTEXT_ENTITY_EXPLICIT_BONUS=1.0
# LUMOGIS_CONTEXT_MAX_EDGES=5
# LUM-308 chat auto-RAG (optional; defaults off — see .env.example for semantics):
# LUMOGIS_AUTO_RAG_ENABLED=false
# LUMOGIS_AUTO_RAG_TOP_K_PRE=20
# LUMOGIS_AUTO_RAG_TOP_K_POST=3
# LUMOGIS_AUTO_RAG_MIN_RERANK_SCORE=0.0
# LUMOGIS_AUTO_RAG_MIN_BI_ENCODER_SCORE=0.55
# LUMOGIS_AUTO_RAG_MAX_TOKENS=512
CAPABILITY_SERVICE_URLS=
MCP_AUTH_TOKEN=

# Bootstrap admin when the users table is empty (first boot of a fresh test volume).
# Email must satisfy LoginRequest validation (use example.com — not reserved/special-use TLDs like `.test`).
LUMOGIS_BOOTSTRAP_ADMIN_EMAIL=rc-smoke-not-real@example.com
LUMOGIS_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe12345!

# Playwright + host integration pytest login (≥12 chars). Override in the environment if needed.
LUMOGIS_WEB_SMOKE_EMAIL=rc-smoke-not-real@example.com
LUMOGIS_WEB_SMOKE_PASSWORD=ChangeMe12345!
# Two-user Playwright live proofs (LUM-582/583/585 — household-sharing-live.spec.ts):
# DEMO_MEMBER_EMAIL=member@yourhome.lan
# DEMO_MEMBER_PASSWORD=ChangeMe12345!

# --- Speech / push / notify (no live sidecars for the default RC gate) ---
STT_BACKEND=none
NOTIFIER_BACKEND=
# WEBPUSH_VAPID_PUBLIC_KEY=
# WEBPUSH_VAPID_PRIVATE_KEY=

# --- Public RC full stack (docker-compose.public-rc-stack.yml) ---
# FalkorDB + lumogis-graph + mock capability — host ports for integration probes.
KG_MEM_LIMIT=2g
FALKORDB_URL=redis://falkordb:6379
MOCK_CAPABILITY_SHARED_SECRET=rc-mock-cap-deterministic-secret-do-not-use-prod
LUMOGIS_GRAPH_HEALTH_URL=http://127.0.0.1:18001/health
LUMOGIS_GRAPH_BASE_URL=http://127.0.0.1:18001
LUMOGIS_MOCK_CAPABILITY_BASE_URL=http://127.0.0.1:18080

# Core test-only chat streaming stub (see orchestrator/routes/api_v1/chat.py).
LUMOGIS_RC_CHAT_STUB=true
LUMOGIS_RC_CHAT_STUB_REPLY=RC_CHAT_STUB_ACK

# Faster session_end processing for Playwright LUM-414 harness (default tick is 5s).
BATCH_QUEUE_TICK_SECONDS=1
BATCH_QUEUE_TICK_DRAIN_LIMIT=16

# LUM-358 — reserved; v1 consolidation lock uses non-blocking pg_try_advisory_lock only.
# LUMOGIS_CONSOLIDATION_LOCK_TIMEOUT_MS=

# --- Compose interpolation (required keys referenced by base compose services) ---
POSTGRES_USER=lumogis
POSTGRES_PASSWORD=lumogis-dev
POSTGRES_DB=lumogis
MONGO_URI=mongodb://mongodb:27017/librechat
JWT_SECRET=test-jwt-secret-placeholder-change-for-non-test-use-only
JWT_REFRESH_SECRET=test-jwt-refresh-secret-placeholder-change-for-non-test-use-only
RESTART_SECRET=test-restart-secret-placeholder
# STACK_CONTROL_URL=http://stack-control:9000
# LUMOGIS_STACK_STATUS_CACHE_TTL_SEC=60
# LUMOGIS_STACK_STATUS_HTTP_TIMEOUT_SEC=45

# LUM-185 — isolated backup dir for compose-test-backup
BACKUP_HOST_DIR=./ai-workspace/backups-test

# --- Experimental feature flags (LUM-126) ---
# All flags default to false; users get clean production behaviour. The features
# below are built incrementally behind these gates. Uncomment + set true to
# develop against one locally. Do NOT enable in the default docker-compose.yml.
# See orchestrator/features.py and CONTRIBUTING.md ("Feature flags").
# LUMOGIS_FF_CONSOLIDATION_AGENT=false   # Sleep-time consolidation agent (LUM-109)
# LUMOGIS_FF_CONTEXT_COMPACTION=false    # Three-layer context compaction (LUM-122)
# LUMOGIS_FF_GRAPH_CONSOLIDATION=false   # Graph consolidation pipeline (LUM-106)
# LUMOGIS_FF_PROACTIVE_PIPES=false       # Proactive routine engine (LUM-110)
# LUMOGIS_FF_TEMPORAL_KG=false           # Two-axis temporal validity on KG edges (LUM-104)
# LUMOGIS_FF_WRITE_BACK_MCP=false        # Write-back MCP tools (LUM-108)
# LUMOGIS_FF_EGRESS_GUARD=false          # In-process egress allowlist on LLM calls (LUM-553)
# Adds a bypassable in-process network guard behind routing policy. Routing policy
# (privacy mode) remains the enforcement contract. This does not guarantee network
# isolation. LUMOGIS_FF_EGRESS_GUARD_CEILING is reserved for a future process-wide
# ceiling chunk — not implemented in v1.

# --- Temporal KG pipeline (LUM-104; read only when LUMOGIS_FF_TEMPORAL_KG is on) ---
# Requires GRAPH_MODE=inprocess in v1. LUMOGIS_TEMPORAL_AUTO_APPLY stays
# false (shadow mode: proposals only) until the eval gate is met on the
# reference judge model — see docs/decisions/151-lum-104-temporal-validity.md.
# LUMOGIS_TEMPORAL_AUTO_APPLY=false         # shadow vs auto-apply invalidations
# LUMOGIS_TEMPORAL_EXTRACT_MODEL=llama      # valid_at extraction (small/fast local tier)
# LUMOGIS_TEMPORAL_JUDGE_MODEL=llama3.1:8b  # contradiction judge (eval-reference class)
# LUMOGIS_TEMPORAL_LLM_CONCURRENCY=2        # semaphore over temporal LLM calls
# LUMOGIS_TEMPORAL_CANDIDATE_LIMIT=10       # candidates per episode
# LUMOGIS_TEMPORAL_MAX_INVALIDATIONS_PER_EPISODE=3
# LUMOGIS_TEMPORAL_CONFIDENCE_FLOOR=0.8     # verdict confidence floor
