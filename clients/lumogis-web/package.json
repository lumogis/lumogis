{
  "name": "lumogis-web",
  "version": "0.0.1",
  "private": true,
  "description": "Lumogis Web — responsive PWA client for the Lumogis orchestrator (chat, memory/search, KG, approvals).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:prove": "E2E_REQUIRE_CREDS=1 playwright test --workers=1",
    "codegen": "node scripts/codegen.mjs",
    "codegen:check": "node scripts/codegen.mjs --check",
    "verify:pwa-dist": "node scripts/check-pwa-dist.mjs"
  },
  "dependencies": {
    "@tanstack/query-sync-storage-persister": "^5.106.1",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-query-persist-client": "^5.106.1",
    "altcha": "^3.5.0",
    "idb-keyval": "^6.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.6",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "workbox-build": {
      "glob": "^14.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    },
    "eslint": {
      "minimatch": "^11.0.5"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.5"
    }
  }
}
