{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumogis.local/schemas/doctor-report-v1.json",
  "title": "Lumogis doctor CLI report v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "generated_at", "summary", "checks"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errors", "warnings", "ok", "skipped"],
      "properties": {
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "ok": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["category", "name", "status", "message", "remediation"],
        "properties": {
          "category": {
            "type": "string",
            "enum": ["services", "models", "config", "security", "storage", "network"]
          },
          "name": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["ok", "warn", "error", "skipped"]
          },
          "message": { "type": "string" },
          "remediation": { "type": "string" }
        }
      }
    }
  }
}
